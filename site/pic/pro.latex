\begin{array}{l}
Minimize: 100\left ( x_3 - x_2^2 \right )^2 + 100 \left ( x_2 - x_1^2 \right )^2 + \left ( 1 - x_2 \right )^2 + \left (  1-x_1\right )^2 \\
Subject\hspace{1.5mm}to:  x_1^2+x_2^2+x_2^3>4 \\
\hspace{5cm} x_1\in \left [ 0, 10 \right ],x_1\in \mathbb{R} \\
\hspace{5cm} x_2\in \left [ 0, 10 \right ],x_2\in \mathbb{Z} \\
\hspace{5cm} x_3\in \left [ 0, 10 \right ],x_3\in \left \{ 2, 3.4, 5.1, 7 \right \}  \\
\end{array}


\begin{array}{c}
f\left ( x \right )  = \sin \left ( x_1 \right ) + a\cdot \sin^2 \left ( x_2 \right ) + b \cdot x_3^4\cdot \sin\left ( x_1 \right ) \\
x_1, x_2,x_3\in \left [ -\pi,\pi  \right ] \\
a=7,b=0.1
\end{array}